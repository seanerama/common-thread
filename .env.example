# Copy outside the checkout, chmod 600, and replace every CHANGE_ME.
APP_IMAGE=ghcr.io/seanerama/common-thread@sha256:CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://common_thread:CHANGE_ME@db:5432/common_thread
DJANGO_SECRET_KEY=CHANGE_ME
APP_ENV=production
ALLOWED_HOSTS=localhost,CHANGE_ME.ts.net
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME.ts.net:8445
APP_HOST_PORT=8010
TRUST_PROXY_HTTPS=true
# Restart/recreate the app after changing feature flags.
PEOPLE_MANAGEMENT_ENABLED=false
CONTEXT_NOTES_ENABLED=false
PARTY_DIRECTORY_ENABLED=false
